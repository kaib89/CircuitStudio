  "notes": [
    {
      "anchor": "U1.GPIO4",
      "id": "N1",
      "text": "R2 pulls the input high, so the button reads LOW when pressed. Configure GPIO4 as a plain input."
    },
    {
      "anchor": "R1",
      "id": "N2",
      "text": "220Ω gives about 6 mA at 3.3 V — plenty for a modern red LED."
    },
    {
      "anchor": "",
      "id": "N3",
      "text": "Notes like this one are written by the assistant and live in the circuit file. You decide where they sit, how wide they are and whether they are shown."
    },
    {
      "anchor": "U1.EN",
      "id": "N4",
      "text": "EN has an internal pull-up and is left open on purpose — the cross says so. Listing a pin in \"nc\" stops it being reported as a missing connection."
    }
  ],
  "title": "ESP32 with status LED and button"
